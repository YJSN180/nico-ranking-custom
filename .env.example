# ===========================================
# Nico Ranking Custom - 環境変数テンプレート
# ===========================================
# このファイルを .env.local にコピーして実際の値を設定してください
# 
# セキュリティ注意事項:
# - プレースホルダー値をそのまま使用しないでください
# - 機密情報をGitHubにコミットしないでください
# - 本番環境ではVercel/Cloudflareの環境変数機能を使用してください
#
# 設定は lib/config.ts で型安全に管理されます

# ===========================================
# Cloudflare設定 (必須)
# ===========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_id_here

# ===========================================
# 認証設定 (必須)
# ===========================================
# Worker間通信の認証キー (32文字以上推奨)
WORKER_AUTH_KEY=your_worker_auth_key_here

# 管理画面アクセス用
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here

# Cron/API保護用シークレット
CRON_SECRET=your_secure_cron_secret_here

# ===========================================
# アプリケーション設定 (環境別)
# ===========================================
# 開発環境: http://localhost:3000
# プレビュー: https://your-app.vercel.app
# 本番環境: https://nico-rank.com
# NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3000

# ===========================================
# 外部サービス設定 (オプション)
# ===========================================
# ニコニコ動画のセンシティブコンテンツアクセス用
# NICO_COOKIES=sensitive_material_status=accept

# Vercelプロテクション回避用（プレビュー環境）
# VERCEL_PROTECTION_BYPASS_SECRET=your_vercel_bypass_secret_here

# ===========================================
# タグ取得設定 (オプション)
# ===========================================
# 基本: Nicolog → getthumbinfo の順で取得
# ENABLE_TAG_FETCHING=true
# TAG_FETCH_MAX_VIDEOS=1000
# TAG_FETCH_GENRES=
# TAG_FETCH_FOR_TAG_RANKINGS=true
# TAG_FETCH_NICOLOG_CONCURRENCY=2
# TAG_FETCH_NICOLOG_MIN_INTERVAL_MS=500
# TAG_FETCH_GETTHUMB_CONCURRENCY=10
# TAG_FETCH_GETTHUMB_MIN_INTERVAL_MS=150
# TAG_FETCH_NICOLOG_TIMEOUT_MS=8000
# TAG_FETCH_GETTHUMB_TIMEOUT_MS=5000

# ===========================================
# デバッグ設定 (開発時のみ)
# ===========================================
# 設定読み込み時のデバッグ情報表示
# DEBUG_CONFIG=true

# ===========================================
# テスト・CI/CD設定 (オプション)
# ===========================================
# Codecovカバレッジレポート用トークン
# CODECOV_TOKEN=your_codecov_token_here
