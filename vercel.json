{
  "regions": [
    "hnd1"
  ],
  "functions": {
    "app/api/admin/update/route.ts": {
      "maxDuration": 60
    },
    "app/api/search/route.ts": {
      "maxDuration": 15
    },
    "app/api/search/realtime-tags/route.ts": {
      "maxDuration": 15
    }
  },
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    }
  ]
}
