{
  "name": "video-stats-updater",
  "version": "1.0.0",
  "description": "Cloudflare Worker for updating video statistics every 2 minutes",
  "main": "src/index.js",
  "scripts": {
    "test": "vitest",
    "test:ci": "vitest run --config vitest.unit.config.mjs test/index.test.js test/utils.test.js --reporter=verbose",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "./deploy.sh",
    "monitor": "node monitor.js",
    "monitor:watch": "node monitor.js --watch",
    "tail": "wrangler tail",
    "format": "prettier --write .",
    "lint": "eslint src test --ext .js"
  },
  "keywords": ["cloudflare-workers", "video-stats", "cron"],
  "type": "module",
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "vitest": "^2.0.0",
    "wrangler": "3.99.0"
  },
  "dependencies": {},
  "overrides": {
    "wrangler": "3.99.0",
    "@cloudflare/vitest-pool-workers": {
      "wrangler": "3.99.0"
    }
  }
}
