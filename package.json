{
  "name": "nico-ranking-new",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:ci": "tsc --noEmit -p tsconfig.test.json",
    "deploy:worker": "./scripts/wrangler-with-token.sh deploy",
    "build:worker": "npm run typecheck:workers && node --check workers/video-stats-updater/src/index.js",
    "test:worker:video-stats": "npm --prefix workers/video-stats-updater run test:ci",
    "deploy:worker:r2": "./scripts/wrangler-with-token.sh deploy -c wrangler-r2.toml",
    "cf:whoami": "./scripts/wrangler-with-token.sh whoami",
    "tail:worker:green": "./scripts/wrangler-with-token.sh tail -c workers/wrangler-green.toml --format pretty",
    "update-ranking": "tsx scripts/update-ranking-parallel-v2.ts",
    "aggregate-ranking": "tsx scripts/aggregate-ranking-results-direct.ts",
    "test-kv-data": "tsx scripts/test-kv-data.ts",
    "update-ranking:group": "tsx scripts/update-ranking-parallel-v2.ts --group",
    "check:all": "npm run typecheck && npm run lint && npm test -- --run && npm run build && npm run build:worker",
    "test": "NODE_OPTIONS='--max-old-space-size=2048' vitest",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=6144' vitest --run",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=16384' vitest --coverage",
    "test:coverage:shard": "NODE_OPTIONS='--max-old-space-size=12288' vitest --coverage",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=2048' vitest run __tests__/unit",
    "test:unit:ci": "NODE_OPTIONS='--max-old-space-size=8192' vitest run __tests__/unit --reporter=verbose --no-coverage",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=2048' vitest run __tests__/integration",
    "test:integration:ci": "NODE_OPTIONS='--max-old-space-size=4096' vitest run __tests__/integration --reporter=verbose --no-coverage",
    "test:e2e": "playwright test tests/e2e/perf-measure.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:with-server": "./scripts/test-with-server.sh",
    "wait-on": "wait-on",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage:report": "vitest --coverage --reporter=html",
    "update-video-stats": "tsx scripts/update-video-stats.ts",
    "typecheck:workers": "tsc --noEmit -p tsconfig.workers.json",
    "update-ng-list": "tsx scripts/update-ng-list.ts",
    "test:kv-api": "vitest run __tests__/unit/cloudflare-kv.test.ts",
    "test:kv-optimization": "vitest run __tests__/integration/workers-kv-optimization.test.ts",
    "generate-tag-accumulation": "tsx scripts/generate-tag-accumulation.ts",
    "upload-tag-accumulation": "tsx scripts/upload-tag-accumulation.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/cloudflare": "^10.49.0",
    "@sentry/nextjs": "^10.49.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "fast-xml-parser": "^5.7.3",
    "idb": "^8.0.3",
    "lucide-react": "^0.540.0",
    "next": "^15.5.9",
    "next-pwa": "^5.6.0",
    "pako": "^2.1.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "tsx": "^4.19.4",
    "web-vitals": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "rollup": "^4.60.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@eslint/eslintrc": "^3.2.0",
    "@next/bundle-analyzer": "^15.3.4",
    "@playwright/test": "^1.53.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.3",
    "axe-playwright": "^2.1.0",
    "critters": "^0.0.23",
    "eslint": "^8",
    "eslint-config-next": "15.5.7",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.0.0",
    "playwright-slack-report": "^1.1.95",
    "subset-font": "^2.4.0",
    "ttf2woff2": "^8.0.0",
    "typescript": "^5",
    "vite": "^6.0.7",
    "vitest": "^3.2.3",
    "wait-on": "^7.2.0",
    "woff2-feature-test": "^1.0.3",
    "wrangler": "^4.23.0"
  }
}
