{
  "name": "nico-ranking-new",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npx next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit -p tsconfig.test.json",
    "deploy:worker": "wrangler deploy",
    "build:worker": "tsc workers/api-gateway-r2-20250706.ts --outDir dist --skipLibCheck --moduleResolution node --target es2022",
    "deploy:worker:r2": "wrangler deploy -c wrangler-r2.toml",
    "update-ranking": "tsx scripts/update-ranking-parallel-v2.ts",
    "aggregate-ranking": "tsx scripts/aggregate-ranking-results-direct.ts",
    "test-kv-data": "tsx scripts/test-kv-data.ts",
    "update-ranking:group": "tsx scripts/update-ranking-parallel-v2.ts --group",
    "check:all": "npm run typecheck && npm run lint && npm test -- --run && npm run build && npm run build:worker",
    "test": "NODE_OPTIONS='--max-old-space-size=2048' vitest",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=6144' vitest --run",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=16384' vitest --coverage",
    "test:coverage:shard": "NODE_OPTIONS='--max-old-space-size=12288' vitest --coverage",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=2048' vitest run __tests__/unit",
    "test:unit:ci": "NODE_OPTIONS='--max-old-space-size=8192' vitest run __tests__/unit --reporter=verbose --no-coverage",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=2048' vitest run __tests__/integration",
    "test:integration:ci": "NODE_OPTIONS='--max-old-space-size=4096' vitest run __tests__/integration --reporter=verbose --no-coverage",
    "test:e2e": "playwright test tests/e2e/perf-measure.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:with-server": "./scripts/test-with-server.sh",
    "wait-on": "wait-on",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage:report": "vitest --coverage --reporter=html",
    "update-video-stats": "tsx scripts/update-video-stats.ts",
    "update-ng-list": "tsx scripts/update-ng-list.ts",
    "test:kv-api": "vitest run __tests__/unit/cloudflare-kv.test.ts",
    "test:kv-optimization": "vitest run __tests__/integration/workers-kv-optimization.test.ts",
    "generate-tag-accumulation": "tsx scripts/generate-tag-accumulation.ts",
    "upload-tag-accumulation": "tsx scripts/upload-tag-accumulation.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "fast-xml-parser": "^5.3.3",
    "idb": "^8.0.3",
    "lucide-react": "^0.561.0",
    "next": "^16.0.10",
    "next-pwa": "^5.6.0",
    "pako": "^2.1.0",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "tsx": "^4.21.0",
    "web-vitals": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251212.0",
    "@next/bundle-analyzer": "^16.0.10",
    "@playwright/test": "^1.53.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "axe-playwright": "^2.2.2",
    "critters": "^0.0.25",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.3.0",
    "playwright-slack-report": "^1.1.100",
    "subset-font": "^2.4.0",
    "ttf2woff2": "^8.0.0",
    "typescript": "^5",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3",
    "woff2-feature-test": "^1.0.3",
    "wrangler": "^4.54.0"
  }
}
