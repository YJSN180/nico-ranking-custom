{
  "name": "nico-ranking-new",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "tsx scripts/post-install.ts",
    "deploy:worker": "wrangler deploy",
    "update-ranking": "tsx scripts/update-ranking-parallel-v2.ts",
    "aggregate-ranking": "tsx scripts/aggregate-ranking-results-direct.ts",
    "test-kv-data": "tsx scripts/test-kv-data.ts",
    "update-ranking:group": "tsx scripts/update-ranking-parallel-v2.ts --group",
    "check:all": "npm run typecheck && npm run lint && npm test -- --run && npm run build",
    "test": "vitest",
    "test:ci": "vitest --config vitest.config.ci.ts --run",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage:report": "vitest --coverage --reporter=html",
    "update-video-stats": "tsx scripts/update-video-stats.ts",
    "update-ng-list": "tsx scripts/update-ng-list.ts",
    "test:kv-api": "vitest run __tests__/unit/cloudflare-kv.test.ts",
    "test:kv-optimization": "vitest run __tests__/integration/workers-kv-optimization.test.ts"
  },
  "dependencies": {
    "@types/jsdom": "^21.1.7",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.3",
    "next": "15.3.3",
    "node-fetch": "^2.7.0",
    "pako": "^2.1.0",
    "react": "^18",
    "react-dom": "^18",
    "tsx": "^4.19.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@stagewise/toolbar-next": "^0.1.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vercel/kv": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^8",
    "eslint-config-next": "15.3.3",
    "fetch-mock": "^10.2.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "typescript": "^5",
    "vite": "^6.0.7",
    "vitest": "^3.2.3",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^3.102.0"
  }
}