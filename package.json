{
  "name": "nico-ranking-new",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit -p tsconfig.test.json",
    "deploy:worker": "wrangler deploy",
    "build:worker": "tsc workers/api-gateway-r2.ts --outDir dist --skipLibCheck --moduleResolution node --target es2022",
    "deploy:worker:r2": "wrangler deploy -c wrangler-r2.toml",
    "update-ranking": "tsx scripts/update-ranking-parallel-v2.ts",
    "aggregate-ranking": "tsx scripts/aggregate-ranking-results-direct.ts",
    "test-kv-data": "tsx scripts/test-kv-data.ts",
    "update-ranking:group": "tsx scripts/update-ranking-parallel-v2.ts --group",
    "check:all": "npm run typecheck && npm run lint && npm test -- --run && npm run build && npm run build:worker",
    "test": "NODE_OPTIONS='--max-old-space-size=2048' vitest",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=4096' vitest --config vitest.config.ci.ts --run",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest --coverage",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=2048' vitest run __tests__/unit",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=2048' vitest run __tests__/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:with-server": "./scripts/test-with-server.sh",
    "wait-on": "wait-on",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage:report": "vitest --coverage --reporter=html",
    "update-video-stats": "tsx scripts/update-video-stats.ts",
    "update-ng-list": "tsx scripts/update-ng-list.ts",
    "test:kv-api": "vitest run __tests__/unit/cloudflare-kv.test.ts",
    "test:kv-optimization": "vitest run __tests__/integration/workers-kv-optimization.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.731.0",
    "fast-xml-parser": "^5.2.5",
    "idb": "^8.0.3",
    "next": "15.3.5",
    "next-pwa": "^5.6.0",
    "pako": "^2.1.0",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "tsx": "^4.20.3",
    "web-vitals": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250704.0",
    "@next/bundle-analyzer": "^15.3.5",
    "@playwright/test": "^1.53.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-playwright": "^2.1.0",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.0.0",
    "playwright-slack-report": "^1.1.98",
    "subset-font": "^2.4.0",
    "ttf2woff2": "^8.0.0",
    "typescript": "^5",
    "vite": "^7.0.2",
    "vitest": "^3.2.3",
    "wait-on": "^8.0.3",
    "woff2-feature-test": "^1.0.3",
    "wrangler": "^4.23.0"
  }
}
